# ==============================================================================
# zapret2 Desktop Supervisor & GUI - Git Ignore Specification
# ==============================================================================

# Node / Frontend Build Outputs
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust / Cargo Build Outputs
src-tauri/target/
**/target/
**/*.rs.bk
*.pdb

# Compiled and upstream binaries, drivers, and dynamic libraries
*.exe
*.dll
*.sys
*.obj
*.lib
*.a
*.zip
# Linux engine binary has no extension; fetched by scripts/setup_binaries.sh
bin/nfqws2
release-pkg/
*-release/
v*-release/


# Upstream Vendor Folders (Kept locally on development workstation)
vendor/
zapret-discord-youtube-main/
zapret2 releases/
zapret2-master/
Zapret-GUI-main/

# User Local Configuration & State
configs/
logs/
.agents/
*.log
*.tmp
*.bak
out.txt
err.txt
Логиtxt.txt

# Workstation helper launcher scripts
Запустить*.*
update_zapret2.bat
push_to_github.bat

# Editor & OS Metadata
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
