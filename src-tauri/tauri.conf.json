{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapret2-supervisor",
  "version": "1.0.8",
  "identifier": "com.zapret2.supervisor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "zapret2 GUI & Supervisor v1.0.8",
        "width": 1050,
        "height": 760,
        "minWidth": 850,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
