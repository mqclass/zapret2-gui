diff --git a/dll/windivert.c b/dll/windivert.c
index f0ec577..be4e670 100644
--- a/dll/windivert.c
+++ b/dll/windivert.c
@@ -49,7 +49,17 @@
 #include "windivert.h"
 #include "windivert_device.h"
 
-#define WINDIVERT_DRIVER_NAME           L"WinDivert"
+#define WINDIVERT_DRIVER_NAME           L"Monkey"
+/*
+ * zapret2-gui (Monkey) modification: the service is registered under a
+ * different name than the device object. Anti-cheats flag the
+ * "WinDivert" service name, while the device (\\.\WinDivert) is created
+ * by the unmodified stock driver and must be opened by its real name -
+ * so only the service name changes here, never WINDIVERT_DEVICE_NAME.
+ * Original: WINDIVERT_DRIVER_NAME was L"WinDivert" and the service used
+ * WINDIVERT_DEVICE_NAME. See scripts/windivert-monkey.patch.
+ */
+#define WINDIVERT_SERVICE_NAME          L"Monkey"
 #define WINDIVERT_DRIVER32_SYS          L"\\" WINDIVERT_DRIVER_NAME L"32.sys"
 #define WINDIVERT_DRIVER64_SYS          L"\\" WINDIVERT_DRIVER_NAME L"64.sys"
 #define WINDIVERT_VERSION_MAJOR_MIN     2
@@ -111,6 +121,35 @@ void *memset(void *dst, int c, size_t n)
     return dst;
 }
 
+#pragma intrinsic(memmove)
+#pragma function(memmove)
+void *memmove(void *dst, const void *src, size_t n)
+{
+    /*
+     * zapret2-gui (Monkey) addition: the DLL must not depend on the
+     * CRT's memmove. The 1.5.2 build pulled the Debug CRT's memmove
+     * in, and its internal memcpy call resolved back to memmove
+     * itself - infinite recursion and STATUS_STACK_OVERFLOW on engine
+     * start (issue #7). A local byte loop, mirroring the custom
+     * memcpy/memset above, keeps the DLL CRT-independent.
+     * Overlap-safe: copies backward when dst > src.
+     */
+    UINT8 *d = (UINT8 *)dst;
+    const UINT8 *s = (const UINT8 *)src;
+    size_t i;
+    if (d < s)
+    {
+        for (i = 0; i < n; i++)
+            d[i] = s[i];
+    }
+    else if (d > s)
+    {
+        for (i = n; i > 0; i--)
+            d[i - 1] = s[i - 1];
+    }
+    return dst;
+}
+
 #define WINDIVERT_INLINE    __forceinline
 
 #else       /* _MSC_VER */
@@ -324,7 +363,7 @@ static BOOLEAN WinDivertDriverInstall(VOID)
     }
 
     // Check if the WinDivert service already exists; if so, start it.
-    service = OpenService(manager, WINDIVERT_DEVICE_NAME, SERVICE_ALL_ACCESS);
+    service = OpenService(manager, WINDIVERT_SERVICE_NAME, SERVICE_ALL_ACCESS);
     if (service != NULL)
     {
         goto WinDivertDriverInstallExit;
@@ -337,15 +376,15 @@ static BOOLEAN WinDivertDriverInstall(VOID)
     }
 
     // Create the service:
-    service = CreateService(manager, WINDIVERT_DEVICE_NAME,
-        WINDIVERT_DEVICE_NAME, SERVICE_ALL_ACCESS, SERVICE_KERNEL_DRIVER,
+    service = CreateService(manager, WINDIVERT_SERVICE_NAME,
+        WINDIVERT_SERVICE_NAME, SERVICE_ALL_ACCESS, SERVICE_KERNEL_DRIVER,
         SERVICE_DEMAND_START, SERVICE_ERROR_NORMAL, windivert_sys, NULL, NULL,
         NULL, NULL, NULL);
     if (service == NULL)
     {
         if (GetLastError() == ERROR_SERVICE_EXISTS) 
         {
-            service = OpenService(manager, WINDIVERT_DEVICE_NAME,
+            service = OpenService(manager, WINDIVERT_SERVICE_NAME,
                 SERVICE_ALL_ACCESS);
         }
         goto WinDivertDriverInstallExit;
